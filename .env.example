# Copy to .env.local and fill in. .env.local is gitignored.

# --- Public (safe to ship in the browser bundle) ---------------------------
# These already have working defaults in src/lib/sanity/client.ts, so you only
# need them here if you point the site at a different project or dataset.
VITE_SANITY_PROJECT_ID=hroyuvjy
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# --- Secret (never prefixed with VITE_, never sent to the browser) ---------
# Only used by `npm run seed`. Create at:
#   https://sanity.io/manage/project/hroyuvjy/api  →  Add API token
#   Name: Finbloom seed script   Permission: Editor
SANITY_API_TOKEN=
